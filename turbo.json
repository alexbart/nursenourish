{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "ENVIRONMENT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:write": {
      "outputs": []
    }
  }
}
